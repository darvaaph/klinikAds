# Salin ke .env.local lalu isi. Jangan commit .env.local.

# --- Supabase (T-002) ---
# Dashboard Supabase > Project Settings > API Keys (dan Data API untuk URL).
# Project baru memakai "publishable key" (sb_publishable_...) = ANON_KEY
# dan "secret key" (sb_secret_...) = SERVICE_ROLE_KEY. Kunci lama (anon/service_role) juga bisa.
NEXT_PUBLIC_SUPABASE_URL=         # https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # RAHASIA, server saja. Jangan dibagikan ke siapa pun.

# --- Sesi & PIN ---
# Minimal 32 karakter acak. Buat baru: node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
SESSION_SECRET=
# Hash bcrypt PIN CMS. Tanda $ wajib ditulis $ (Next.js membaca $ sebagai variabel).
# PIN admin demo untuk hash di bawah: 129707  (ganti sebelum pitching)
ADMIN_PIN_HASH=\$2b\$10\$HRcdTrM8bEfpbML72yljPe4eSY/0pYjSu6db.7N.LALE5CVpxQZsO

# Reset demo hanya aktif kalau true (API §3).
MODE_DEMO=true
